@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel='stylesheet' href="//cdn.datatables.net/2.3.5/css/dataTables.dataTables.min.css" />
<link rel='stylesheet' href="https://cdn.datatables.net/responsive/3.0.7/css/responsive.dataTables.css" />
<div class="container">
    <h1>Ammo</h1>
    <div id="loadingDiv" class="row">
        <img src="https://media.tenor.com/Pq1cZiuhlEEAAAAi/rajinikanth.gif"  style="width: 50px; height: 50px" />
    </div>
    <div id="divCaliber" class="row d-none">
        <label for="ddlCaliber" class="form-label mt-4">Select the Caliber</label>
        <select class="form-select" id="ddlCaliber">
            <option></option>
        </select>
    </div>
    <hr />
    <div id="divAmmoTable" class="row d-none">
        <table id="myTable" class="table table-striped nowrap">
            <thead>
                <tr>
                    <th class="d-none d-lg-table-cell">Template Id</th>
                    <th>Name</th>
                    <th class="d-none d-lg-table-cell">Caliber</th>
                    <th class="d-none d-lg-table-cell">Armor Damage</th>
                    <th class="d-none d-lg-table-cell">Penetration</th>
                    <th class="d-none d-lg-table-cell">Damage</th>
                    <th class="d-none d-lg-table-cell">Rating Value</th>
                    <th>Rating</th>
                    <th class="d-none d-lg-table-cell">Tier</th>
                </tr>
            </thead>
            <tbody id="myTableBody">
                
            </tbody>
        </table>
    </div>
</div>

<!-- Add JQUERY -->
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.datatables.net/2.3.5/js/dataTables.js"></script>
<script>

    $.get('/api/v1/itemSearch/getAmmoCalibers', function(resp) {

        let data = resp.data;
        document.getElementById('ddlCaliber').innerHTML = '';
        let defaultOption = document.createElement('option');
        document.getElementById('ddlCaliber').appendChild(defaultOption);

        for (let d of data) {
            let option = document.createElement('option');
            option.value = d;
            option.innerText = d;
            document.getElementById('ddlCaliber').appendChild(option);
        }

        document.getElementById('loadingDiv').classList.add('d-none');
        document.getElementById('divCaliber').classList.remove('d-none');
        document.getElementById('divAmmoTable').classList.remove('d-none');
    });

    $('#ddlCaliber').on("change", (function(d) {
    
        document.getElementById('loadingDiv').classList.remove('d-none');

        let caliberVal = $('#ddlCaliber').val();
        $.post(`/api/v1/itemSearch/getAmmo/${caliberVal}` , function(resp) {

            document.getElementById('loadingDiv').classList.add('d-none');

            document.getElementById('myTableBody').innerHTML = '';

            let data = resp.data;

            for (let d of data) {

                let tr = document.createElement('tr');

                for (let k of Object.keys(d)) {
                    let td = document.createElement('td');
                    td.innerText = d[k];

                    if (k != 'ratingWord' && k != 'langItem') {
                        td.classList.add('d-none');
                        td.classList.add('d-lg-table-cell');
                    }

                    tr.appendChild(td);
                }
                document.getElementById('myTableBody').appendChild(tr);
            }


        });
    }));

    

</script>
