@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel='stylesheet' href="//cdn.datatables.net/2.2.1/css/dataTables.dataTables.min.css" />
<div class="container">
    <h1>Items</h1>
    <div>
        <table id="myTable">
            <thead>
                <tr>
                    <th class="d-none d-lg-table-cell">Template Id</th>
                    <th >Name</th>
                    <th class="d-none d-lg-table-cell">Parent Id</th>
                    <th class="d-none d-lg-table-cell">Parent Name</th>
                    <th class="d-none d-lg-table-cell">Price</th>
                    <th>Rating</th>
                </tr>
            </thead>
        </table>
    </div>
</div>


<!-- Add JQUERY -->
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="//cdn.datatables.net/2.2.1/js/dataTables.min.js"></script>
<script>
    // JQuery search for "myTable" and apply DataTable to it
    $('#myTable').DataTable({
        "ajax": {
          "url": '/itemSearch/getItemEnglishNameAndTpl/',
          "type": "POST"
        },
        columns: [
          { data: 'itemId' },
          { data: 'langItem' },
          { data: 'parentId' },
          { data: 'parentIdLang' },
          { data: 'price' },
          { data: 'priceRatio' }
        ],
        processing: false,
        serverSide: false
    });

</script>
